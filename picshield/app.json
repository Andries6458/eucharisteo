{
  "expo": {
    "name": "PicShield",
    "slug": "picshield",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "picshield",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F14",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F14"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.eucharisteo.picshield",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PicShield reads photos you select so it can audit and remove embedded metadata. Processing is local; nothing is uploaded.",
        "NSPhotoLibraryAddUsageDescription": "PicShield saves the cleaned copy of your photo back to local storage."
      }
    },
    "android": {
      "package": "com.eucharisteo.picshield",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F14"
      },
      "permissions": ["READ_MEDIA_IMAGES"],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "PicShield",
      "shortName": "PicShield",
      "themeColor": "#0B0F14",
      "backgroundColor": "#0B0F14",
      "display": "standalone"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "PicShield reads photos you select so it can audit and remove embedded metadata."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
