{
  "expo": {
    "name": "Financial Advisor",
    "slug": "financial-advisor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "backgroundColor": "#0B1220",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eucharisteo.financialadvisor",
      "infoPlist": {
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "package": "com.eucharisteo.financialadvisor",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B1220"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Financial Advisor"
    }
  }
}
